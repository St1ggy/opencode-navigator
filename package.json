{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-navigator",
  "version": "0.20.0",
  "description": "Search, navigate, and manage OpenCode sessions from the TUI",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "license": "MIT",
  "author": "St1ggy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/St1ggy/opencode-navigator.git"
  },
  "homepage": "https://github.com/St1ggy/opencode-navigator#readme",
  "bugs": {
    "url": "https://github.com/St1ggy/opencode-navigator/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "sidebar",
    "search",
    "navigator",
    "skills",
    "mcp"
  ],
  "files": [
    "dist",
    "server.js",
    "rpc.js",
    "assets",
    "scripts/install-font.mjs",
    "scripts/update-local-snapshot.mjs",
    "scripts/save-project-profile.mjs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "bin": {
    "opencode-navigator-font": "scripts/install-font.mjs",
    "opencode-navigator-profile": "scripts/save-project-profile.mjs"
  },
  "exports": {
    "./tui": {
      "import": "./dist/tui.js"
    },
    "./server": {
      "import": "./dist/server.js"
    },
    "./rpc": {
      "import": "./dist/rpc.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "opencode": ">=1.18.30"
  },
  "scripts": {
    "build": "bun run build.ts",
    "bundle:size": "bun run build && bun run scripts/check-bundle-size.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "font:install": "node scripts/install-font.mjs",
    "font:build": "uv run scripts/generate-corner-font.py",
    "font:check": "uv run scripts/generate-corner-font.py --check",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings && bun run format",
    "prepublishOnly": "bun run check",
    "screenshots": "bash scripts/capture-screenshots.sh",
    "screenshots:verify": "bash scripts/capture-screenshots.sh --verify",
    "test": "bun run build && bun test --preload @opentui/solid/preload",
    "test:e2e": "bun run build && bash scripts/smoke-opencode.sh && bash scripts/smoke-opencode-v2.sh",
    "test:e2e:v1": "bun run build && bash scripts/smoke-opencode.sh",
    "test:e2e:v2": "bun run build && bash scripts/smoke-opencode-v2.sh",
    "typecheck": "tsc --noEmit",
    "check": "bun run test && bun run typecheck && bun run lint && bun run bundle:size && bun run format:check"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.30",
    "@opencode/plugin": ">=2.0.11",
    "@opentui/core": ">=0.4.5",
    "@opentui/solid": ">=0.4.5",
    "solid-js": ">=1.9.12"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    },
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.34",
    "@opencode-ai/sdk": "1.18.34",
    "@opencode/plugin": "2.0.21",
    "@opentui/core": "0.5.12",
    "@opentui/keymap": "0.5.12",
    "@opentui/solid": "0.5.12",
    "@st1ggy/linter-config": "8.0.0",
    "@types/bun": "1.4.2",
    "eslint-plugin-solid": "0.18.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "solid-js": "1.9.15",
    "typescript": "6.0.3",
    "web-tree-sitter": "0.25.10"
  }
}
