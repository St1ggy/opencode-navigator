{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-navigator",
  "version": "0.27.4",
  "description": "Search, navigate, and manage OpenCode sessions in the TUI and experimental Desktop GUI",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "license": "MIT",
  "author": "St1ggy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/St1ggy/opencode-navigator.git"
  },
  "homepage": "https://github.com/St1ggy/opencode-navigator#readme",
  "bugs": {
    "url": "https://github.com/St1ggy/opencode-navigator/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "sidebar",
    "search",
    "navigator",
    "skills",
    "mcp"
  ],
  "files": [
    "dist",
    "server.js",
    "rpc.js",
    "assets",
    "patches",
    "scripts/install-font.mjs",
    "scripts/update-local-snapshot.mjs",
    "scripts/snapshot-runtime.mjs",
    "scripts/snapshot-verifier.mjs",
    "scripts/save-project-profile.mjs",
    "README.md",
    "PROVIDERS.md",
    "HOST_API.md",
    "LINT_COVERAGE.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "bin": {
    "opencode-navigator-font": "scripts/install-font.mjs",
    "opencode-navigator-profile": "scripts/save-project-profile.mjs"
  },
  "exports": {
    "./gui-experimental": "./dist/gui-experimental.cjs",
    "./tui": {
      "import": "./dist/tui.js"
    },
    "./server": {
      "import": "./dist/server.js"
    },
    "./rpc": {
      "import": "./dist/rpc.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "opencode": "1.19.5 || 2.2.6"
  },
  "scripts": {
    "build": "bun run build.ts",
    "build:gui": "vite build --config vite.gui.config.ts",
    "bundle:size": "bun run build && bun run scripts/check-bundle-size.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "font:install": "node scripts/install-font.mjs",
    "font:build": "uv run scripts/generate-corner-font.py",
    "font:check": "uv run scripts/generate-corner-font.py --check",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings && bun run format",
    "prepublishOnly": "bun run check",
    "screenshots": "bash scripts/capture-screenshots.sh",
    "screenshots:verify": "bash scripts/capture-screenshots.sh --verify",
    "screenshots:gui": "bun scripts/capture-gui-screenshots.mjs",
    "screenshots:gui:verify": "bun scripts/capture-gui-screenshots.mjs --verify",
    "test": "bun run build && bun test --preload @opentui/solid/preload ./test/*.test.ts ./test/*.test.tsx",
    "test:e2e": "bun run build && bash scripts/smoke-opencode.sh && bash scripts/smoke-opencode-v2.sh",
    "test:e2e:v1": "bun run build && bash scripts/smoke-opencode.sh",
    "test:e2e:v2": "bun run build && bash scripts/smoke-opencode-v2.sh",
    "test:gui": "bun run build:gui && bun test --conditions browser test/gui",
    "test:coverage": "bun run build && bun run test:coverage:tui && bun run test:coverage:gui && bun run coverage:summary",
    "test:coverage:tui": "bun test --coverage --coverage-reporter=lcov --coverage-dir coverage/tui --preload @opentui/solid/preload ./test/*.test.ts ./test/*.test.tsx",
    "test:coverage:gui": "bun test --conditions browser --coverage --coverage-reporter=lcov --coverage-dir coverage/gui test/gui",
    "coverage:summary": "bun run scripts/coverage-summary.ts",
    "test:e2e:gui": "bun run build && node scripts/smoke-opencode-gui.mjs",
    "typecheck:gui": "tsc --project tsconfig.gui.json && tsc --project tsconfig.gui-test.json",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.ffi.json && bun run typecheck:gui",
    "check": "bun run test && bun run test:gui && bun run typecheck && bun run lint && bun run bundle:size && bun run format:check"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "1.19.5",
    "@opencode/plugin": "2.2.6",
    "@opentui/core": ">=0.4.5",
    "@opentui/solid": ">=0.4.5",
    "solid-js": ">=1.9.12"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    },
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.19.5",
    "@opencode-ai/sdk": "1.19.5",
    "@opencode/client": "2.2.6",
    "@opencode/plugin": "2.2.6",
    "@opencode/theme": "2.2.6",
    "@opentui/core": "0.8.3",
    "@opentui/keymap": "0.8.3",
    "@opentui/solid": "0.8.3",
    "@playwright/test": "1.65.0",
    "@st1ggy/linter-config": "10.0.0",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "effect": "4.1.0",
    "electron": "44.9.1",
    "eslint-plugin-solid": "0.18.1",
    "jsonc-parser": "3.3.1",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "solid-js": "1.9.18",
    "typescript": "6.0.3",
    "vite": "8.3.7",
    "vite-plugin-solid": "2.11.15",
    "web-tree-sitter": "0.25.10"
  },
  "optionalDependencies": {
    "@github/copilot-sdk": "1.0.30"
  },
  "patchedDependencies": {
    "bun-ffi-structs@0.3.1": "patches/bun-ffi-structs@0.3.1.patch"
  }
}
