{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-pretty-sidebar",
  "version": "0.4.10",
  "description": "A focused, interactive sidebar for the OpenCode TUI",
  "type": "module",
  "license": "MIT",
  "author": "St1ggy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/St1ggy/opencode-pretty-sidebar.git"
  },
  "homepage": "https://github.com/St1ggy/opencode-pretty-sidebar#readme",
  "bugs": {
    "url": "https://github.com/St1ggy/opencode-pretty-sidebar/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "sidebar",
    "skills",
    "mcp"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./tui": {
      "import": "./dist/tui.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "opencode": ">=1.18.30"
  },
  "scripts": {
    "build": "bun run build.ts",
    "prepublishOnly": "bun run check",
    "test": "bun run build && bun test --preload @opentui/solid/preload",
    "typecheck": "tsc --noEmit",
    "check": "bun run test && bun run typecheck"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.30",
    "@opentui/core": ">=0.4.5",
    "@opentui/keymap": ">=0.4.5",
    "@opentui/solid": ">=0.4.5",
    "solid-js": ">=1.9.10"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.30",
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@opentui/solid": "0.4.5",
    "@types/bun": "1.3.13",
    "solid-js": "1.9.12",
    "typescript": "5.8.2",
    "web-tree-sitter": "0.25.10"
  }
}
